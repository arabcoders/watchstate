{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "format": "oxfmt --write app",
        "format:check": "oxfmt --check  app",
        "lint": "eslint .",
        "lint:ci": "eslint . --quiet",
        "lint:fix": "eslint . --fix",
        "lint:tsc": "vue-tsc --noEmit",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:ci": "bun test --dots",
        "prepare:test": "nuxt prepare --envName=development"
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.145",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@noble/hashes": "^2.4.0",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/eslint-config": "^1.17.0",
        "@nuxt/ui": "^4.12.0",
        "@vueuse/core": "^14.4.0",
        "@vueuse/nuxt": "^14.4.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "assjs": "0.1.10",
        "cronstrue": "^3.32.0",
        "hls.js": "^1.7.3",
        "marked": "^18.1.1",
        "marked-alert": "^2.1.2",
        "marked-base-url": "^1.1.10",
        "marked-gfm-heading-id": "^4.1.4",
        "moment": "^2.31.0",
        "nuxt": "^4.6.2",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vuedraggable": "^4.1.0"
    },
    "overrides": {
        "vuedraggable": "^4.1.0"
    },
    "trustedDependencies": [
        "esbuild",
        "@parcel/watcher"
    ],
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "@types/node": "26.1.2",
        "@typescript-eslint/parser": "^8.71.2",
        "eslint": "^10.13.0",
        "oxfmt": "^0.62.0",
        "typescript": "^6.0.3",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.13"
    },
    "eslintIgnore": [
        ".gitignore"
    ],
    "patchedDependencies": {
        "assjs@0.1.10": "patches/assjs@0.1.10.patch"
    }
}
